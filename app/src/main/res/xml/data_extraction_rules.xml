<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: нічого з даних застосунку (токени, кеш, повідомлення) не потрапляє в хмарну копію й не переноситься на інший пристрій -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
